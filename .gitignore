# Basic Jekyll gitignores (synchronize to Jekyll.gitignore)
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Additional Ruby/bundler ignore for when you run: bundle install
/vendor
Gemfile.lock

# generated types
**/.astro/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# node
**/node_modules/
**/dist/

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# setting folder
**/.idea/
**/.vscode/
