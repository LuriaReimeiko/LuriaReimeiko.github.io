---
import Base from '@layouts/base.astro';
import StarfieldCanvas from '@components/StarfieldCanvas.astro';
import ScrambleText from '@components/ScrambleText.astro';

import { Image } from 'astro:assets';

// Nav items in the order you specified
const navItems = [
    { label: 'portfolio', href: '/portfolio', ready: true },
    { label: 'projects', href: '/projects', ready: true },
    { label: 'hardware', href: '/hardware', ready: true },
    { label: 'software', href: '/software', ready: true },
    { label: 'music', href: '/music', ready: true },
];
---

<Base title="Luria Kei" description="Personal site of Luria Kei">
    <div class="page home">
        <StarfieldCanvas />

        <!-- Identity -->
        <header class="identity" transition:name="identity">
            <div class="avatar-wrap">
                <Image class="avatar" src="/avatar.png" alt="Luria Reimeiko" width="72" height="72" />
            </div>

            <h1 class="name name-top font-display">Luria</h1>
            <div class="separator"></div>
            <h1 class="name name-bottom font-display">Reimeiko</h1>
            <p class="tagline font-body">— game developer/designer —</p>
            <p class="tagline font-body text-dim short-line">giving life to pixels</p>
        </header>

        <!-- Navigation -->
        <nav class="nav" aria-label="Site navigation">
            {
                navItems.map((item) => (
                    <a href={item.href} class="nav-btn" aria-label={`Go to ${item.label}`}>
                        <ScrambleText text={item.label} trigger=".nav-btn" tag="span" />
                    </a>
                ))
            }
        </nav>

        <footer class="footer socials">
            <nav aria-label="Social and contact links">
                <a href="https://www.youtube.com/@LuriaReimeiko" target="_blank" aria-label="Youtube" class="social_a">
                    <i class="bxl bx-youtube" aria-hidden="true"></i>
                </a>
                <a href="https://github.com/LuriaReimeiko" target="_blank" aria-label="Github" class="social_a">
                    <i class="bxl bx-github" aria-hidden="true"></i>
                </a>
                <a href="mailto:Reimeiko@proton.me" aria-label="Email us" class="social_a">
                    <i class="bx bx-envelope-alt" aria-hidden="true"></i>
                </a>
            </nav>
        </footer>

        <!-- Deco -->
        <div class="corner-glyph corner-glyph--tl" aria-hidden="true">✦</div>
        <div class="corner-glyph corner-glyph--tr" aria-hidden="true">✦</div>
        <div class="corner-glyph corner-glyph--bl" aria-hidden="true">✦</div>
        <div class="corner-glyph corner-glyph--br" aria-hidden="true">✦</div>
    </div>
</Base>

<style>
    /* Shell */
    .home {
        justify-content: flex-start;
        align-items: center;
    }

    .footer {
        display: flex;
        gap: var(--space-8);
        position: fixed;
        bottom: var(--space-8);
    }

    .socials {
        font-size: var(--text-2xl);
        color: rgba(var(--color-primary-rgb), 0.5);
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
    }

    .social_a {
        justify-content: center;
        display: inline-flex;
        color: inherit;
        text-decoration: none;
        transition: color var(--dur-base) var(--ease-in-out);
    }
    .social_a:hover {
        color: rgba(var(--color-primary-rgb), 1);
    }

    /* Identity block */
    .identity {
        position: relative;
        z-index: var(--z-content);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3);
        padding-top: clamp(var(--space-12), 10vh, var(--space-16));
        padding-bottom: var(--space-8);
    }

    .avatar-wrap {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        border: 1px solid var(--color-border);
        overflow: hidden;
        background: var(--color-panel);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px var(--color-glow);
        transition: box-shadow var(--dur-slow) var(--ease-out);
    }

    .avatar-wrap:hover {
        box-shadow:
            0 0 30px var(--color-glow),
            0 0 20px var(--color-glow),
            0 0 15px var(--color-glow);
    }

    .avatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .avatar-fallback {
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .separator {
        display: block;
        width: 50%;
        height: 1px;
        background-color: var(--color-text-dim);
        margin: 0;
        margin-left: -20%;
        padding: 0;
        gap: 0;
    }

    .name {
        font-size: var(--text-4xl);
        font-weight: 400;
        letter-spacing: 0.04em;
        color: var(--color-text);
        line-height: 1;
    }
    .name:hover {
        animation:
            title-glow-startup 1.5s forwards,
            title-glow-flicker 4s 1.5s infinite;
    }

    .name-top {
        margin-left: -47.5%;
        margin-bottom: -0.2em;
    }

    .name-bottom {
        margin-left: 12.5%;
        margin-top: -0.2em;
    }

    .tagline {
        font-size: var(--text-sm);
        letter-spacing: 0.12em;
        text-transform: lowercase;
    }

    /* Nav */
    .nav {
        position: relative;
        z-index: var(--z-content);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3);
    }

    .nav-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--nav-button-w);
        height: var(--nav-button-h);
        background: var(--color-panel);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        color: var(--color-text-dim);
        font-family: var(--font-heading);
        font-size: var(--text-base);
        letter-spacing: 0.14em;
        text-decoration: none;
        text-transform: lowercase;
        cursor: pointer;
        transition:
            color var(--dur-base) var(--ease-out),
            border-color var(--dur-base) var(--ease-out),
            box-shadow var(--dur-base) var(--ease-out),
            background var(--dur-base) var(--ease-out);
    }

    .nav-btn:hover {
        color: var(--color-text);
        border-color: var(--color-border-hover);
        box-shadow: 0 0 16px var(--color-glow);
        background: rgba(35, 33, 50, 0.85);
    }

    .nav-btn:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 3px;
    }

    /* Corner glyphs */
    .corner-glyph {
        position: fixed;
        z-index: var(--z-content);
        font-size: var(--text-xl);
        color: var(--color-border-hover);
        user-select: none;
        pointer-events: none;
        font-family: serif;
        transition: color var(--dur-slow) var(--ease-out);
        /* slow drift on load */
        animation: glyph-fade-in 2s var(--ease-out) both;
    }

    .corner-glyph--tl {
        top: var(--space-6);
        left: var(--space-8);
    }
    .corner-glyph--tr {
        top: var(--space-6);
        right: var(--space-8);
    }
    .corner-glyph--bl {
        bottom: var(--space-6);
        left: var(--space-8);
    }
    .corner-glyph--br {
        bottom: var(--space-6);
        right: var(--space-8);
    }

    @keyframes glyph-fade-in {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mobile */
    @media (max-width: 480px) {
        .name {
            font-size: var(--text-3xl);
        }
        .nav-btn {
            width: 90vw;
            max-width: var(--nav-button-w);
        }

        .footer {
            gap: var(--space-3);
            bottom: var(--space-3);
        }
    }

    /* Aimation */
    @keyframes title-glow-startup {
        2%,
        17%,
        23%,
        38%,
        78%,
        95% {
            text-shadow:
                0 0 2px var(--color-text),
                0 0 5px var(--color-text),
                0 0 15px var(--color-primary),
                0 0 20px var(--color-primary);
        }
        0%,
        14%,
        32%,
        90% {
            text-shadow: none;
        }

        20%,
        34%,
        72% {
            text-shadow:
                0 0 2px var(--color-text),
                0 0 4px var(--color-text);
        }
    }

    @keyframes title-glow-flicker {
        0%,
        18%,
        22%,
        25%,
        53%,
        57%,
        100% {
            text-shadow:
                0 0 2px var(--color-text),
                0 0 5px var(--color-text),
                0 0 15px var(--color-primary),
                0 0 20px var(--color-primary);
        }

        20%,
        24%,
        55% {
            text-shadow:
                0 0 2px var(--color-text),
                0 0 4px var(--color-text);
        }

        21%,
        56% {
            text-shadow: none;
        }
    }
</style>
