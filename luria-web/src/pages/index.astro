---
import Base from "@layouts/base.astro";
import StarfieldCanvas from "@components/StarfieldCanvas.astro";
import ScrambleText from "@components/ScrambleText.astro";

import { Image } from "astro:assets";

// Nav items in the order you specified
const navItems = [
    { label: "portfolio", href: "/portfolio", ready: true },
    { label: "projects", href: "/projects", ready: true },
    { label: "hardware", href: "/hardware", ready: true },
    { label: "software", href: "/software", ready: true },
    { label: "music", href: "/music", ready: true },
];
---

<Base title="Luria Kei" description="Personal site of Luria Kei">
    <div class="page home">
        <StarfieldCanvas />

        <header class="identity" transition:name="identity">
            <div class="avatar-wrap">
                <Image
                    class="avatar"
                    src="/avatar.png"
                    alt="Luria Reimeiko"
                    width="72"
                    height="72"
                />
            </div>

            <h1 class="name font-display">Luria Reimeiko</h1>
            <p class="tagline font-body">
                — game developer · designer —
            </p>
            <p class="tagline font-body text-dim">
                giving life to pixels
            </p>
        </header>

        <!-- Navigation -->
        <nav class="nav" aria-label="Site navigation">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class="nav-btn"
                        aria-label={`Go to ${item.label}`}
                    >
                        <ScrambleText text={item.label} tag="span" />
                    </a>
                ))
            }
        </nav>

        <!-- Deco -->
        <div class="corner-glyph corner-glyph--tl" aria-hidden="true">✦</div>
        <div class="corner-glyph corner-glyph--tr" aria-hidden="true">✦</div>
        <div class="corner-glyph corner-glyph--bl" aria-hidden="true">✦</div>
        <div class="corner-glyph corner-glyph--br" aria-hidden="true">✦</div>
    </div>
</Base>

<style>
    /* shell */
    .home {
        justify-content: flex-start;
        align-items: center;
    }

    /* ── Identity block ── */
    .identity {
        position: relative;
        z-index: var(--z-content);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3);
        padding-top: clamp(var(--space-12), 10vh, var(--space-16));
        padding-bottom: var(--space-8);
    }

    .avatar-wrap {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        border: 1px solid var(--color-border);
        overflow: hidden;
        background: var(--color-panel);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px var(--color-glow);
        transition: box-shadow var(--dur-slow) var(--ease-out);
    }

    .avatar-wrap:hover {
        box-shadow: 0 0 36px rgba(213, 184, 255, 0.32);
    }

    .avatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .avatar-fallback {
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }

    .name {
        font-size: var(--text-4xl);
        font-weight: 400;
        letter-spacing: 0.04em;
        color: var(--color-text);
        line-height: 1;
        /* Subtle primary glow on the name */
        text-shadow: 0 0 32px rgba(213, 184, 255, 0.25);
    }

    .tagline {
        font-size: var(--text-sm);
        letter-spacing: 0.12em;
        text-transform: lowercase;
    }

    /* ── Nav ── */
    .nav {
        position: relative;
        z-index: var(--z-content);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3);
    }

    .nav-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--nav-button-w);
        height: var(--nav-button-h);
        background: var(--color-panel);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        color: var(--color-text-dim);
        font-family: var(--font-heading);
        font-size: var(--text-base);
        letter-spacing: 0.14em;
        text-decoration: none;
        text-transform: lowercase;
        cursor: pointer;
        transition:
            color var(--dur-base) var(--ease-out),
            border-color var(--dur-base) var(--ease-out),
            box-shadow var(--dur-base) var(--ease-out),
            background var(--dur-base) var(--ease-out);
    }

    .nav-btn:hover {
        color: var(--color-text);
        border-color: var(--color-border-hover);
        box-shadow: 0 0 16px var(--color-glow);
        background: rgba(35, 33, 50, 0.85);
    }

    .nav-btn:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 3px;
    }

    /* ── Corner glyphs ── */
    .corner-glyph {
        position: fixed;
        z-index: var(--z-content);
        font-size: var(--text-xl);
        color: var(--color-border-hover);
        user-select: none;
        pointer-events: none;
        font-family: serif;
        transition: color var(--dur-slow) var(--ease-out);
        /* slow drift on load */
        animation: glyph-fade-in 2s var(--ease-out) both;
    }

    .corner-glyph--tl {
        top: var(--space-6);
        left: var(--space-8);
    }
    .corner-glyph--tr {
        top: var(--space-6);
        right: var(--space-8);
    }
    .corner-glyph--bl {
        bottom: var(--space-6);
        left: var(--space-8);
    }
    .corner-glyph--br {
        bottom: var(--space-6);
        right: var(--space-8);
    }

    @keyframes glyph-fade-in {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Responsive ── */
    @media (max-width: 480px) {
        .name {
            font-size: var(--text-3xl);
        }
        .nav-btn {
            width: 90vw;
            max-width: var(--nav-button-w);
        }
        .corner-glyph--tr,
        .corner-glyph--br {
            display: none;
        }
    }
</style>
