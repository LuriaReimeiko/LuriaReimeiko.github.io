---
import Base from '@layouts/base.astro';
import BackButton from '@components/BackButton.astro';

// Markdown pages pass their frontmatter nested under Astro.props.frontmatter,
// not as flat top-level props (confirmed against Astro's docs — this is the
// documented, correct shape for .md pages using the `layout:` frontmatter
// field, distinct from how a normal .astro component receives props).
interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const { title, description } = frontmatter;
---

<Base title={title} description={description}>
  <BackButton href="/hardware" label="hardware" />
  <main class="md-page">
    <article class="md-content">
      <slot />
    </article>
  </main>
</Base>

<style>
  :global(.md-content), :global(.md-content *), :global(.md-content *::before), :global(.md-content *::after) {
  user-select: text !important;
  -webkit-user-select: text !important;
  -pointer-events: auto;
}
  .md-page {
    min-height: 100dvh;
    overflow-y: auto;
    display: flex;
    justify-content: center;
    padding: var(--space-16) var(--space-6) var(--space-16);
  }

  .md-content {
    width: 100%;
    max-width: 720px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  /* ── Headings ── */
  .md-content :global(h1) {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    letter-spacing: 0.03em;
    margin-bottom: var(--space-2);
  }

  .md-content :global(h2) {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    letter-spacing: 0.02em;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .md-content :global(h3) {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .md-content :global(h4),
  .md-content :global(h5),
  .md-content :global(h6) {
    font-family: var(--font-body);
    font-weight: 700;
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }

  /* ── Body text ── */
  .md-content :global(p) {
    margin-bottom: var(--space-4);
    color: var(--color-text-dim);
  }

  .md-content :global(em) {
    color: var(--color-text-dim);
  }

  .md-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-hover);
    text-underline-offset: 2px;
  }

  .md-content :global(a:hover) {
    text-decoration-color: var(--color-primary);
  }

  .md-content :global(strong) {
    color: var(--color-text);
  }

  .md-content :global(code) {
    background: var(--color-panel);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1em 0.4em;
    font-size: 0.9em;
  }

  /* ── Tables ── */
  .md-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .md-content :global(th),
  .md-content :global(td) {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .md-content :global(th) {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-weight: 400;
    letter-spacing: 0.04em;
    font-size: var(--text-xs);
    text-transform: lowercase;
  }

  .md-content :global(td) {
    color: var(--color-text-dim);
  }

  .md-content :global(tr:hover td) {
    color: var(--color-text);
  }

  /* ── Lists ── */
  .md-content :global(ul),
  .md-content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
    color: var(--color-text-dim);
  }

  .md-content :global(li) {
    margin-bottom: var(--space-1);
  }

  /* ── Misc ── */
  .md-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-8) 0;
  }

  @media (max-width: 480px) {
    .md-page {
      padding: var(--space-12) var(--space-4) var(--space-12);
    }
  }
</style>