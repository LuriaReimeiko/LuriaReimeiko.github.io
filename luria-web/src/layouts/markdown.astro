---
import Base from "@layouts/base.astro";
import BackButton from "@components/BackButton.astro";

// Markdown pages pass their frontmatter nested under Astro.props.frontmatter,
// not as flat top-level props (confirmed against Astro's docs — this is the
// documented, correct shape for .md pages using the `layout:` frontmatter
// field, distinct from how a normal .astro component receives props).
interface Props {
    frontmatter: {
        title?: string;
        description?: string;
    };
}

const { frontmatter } = Astro.props;
const { title, description } = frontmatter;
---

<Base title={title} description={description}>
    <BackButton href="/hardware" label="hardware" />
    <main class="md-page">
        <article class="md-content" id="md-content">
            <slot />
        </article>
    </main>
</Base>

<script>
    // Make every h2-h6 in the rendered markdown foldable, using native
    // <details>/<summary> (no extra JS state to manage, free keyboard/
    // accessibility support). Re-run fresh on every 'astro:page-load' —
    // not just once at module scope — per the same lifecycle pattern used
    // elsewhere on this site: View Transitions don't guarantee inline
    // scripts re-run their top-level code on navigation, so re-querying
    // and re-wrapping from scratch each time avoids acting on stale DOM.
    //
    // h1 is intentionally left alone (it's the page title, not a fold target).

    function headingLevel(el: Element): number {
        return Number(el.tagName.slice(1)); // "H2" -> 2
    }

    function foldHeadings() {
        const root = document.getElementById("md-content");
        if (!root) return;

        if (root.dataset.foldInit === "1") return;

        const headings = Array.from(
            root.querySelectorAll("h2, h3, h4, h5, h6"),
        );

        // Returns the heading-level a sibling node represents for the purpose
        // of deciding where a fold's content should stop — either a raw
        // h2-h6 tag, or a <details class="md-fold"> already wrapped by an
        // earlier step in THIS pass (tagged with data-level on creation).
        // Without checking the second case, two same-level siblings (e.g.
        // two h3s under one h2) would fail to stop at each other: once the
        // later h3 is wrapped into a <details>, it stops being recognized
        // as "a heading" by a naive tag-name check, and the earlier h3's
        // content collection would incorrectly swallow it.
        function siblingLevel(el: Element): number | null {
            if (/^H[1-6]$/.test(el.tagName)) return headingLevel(el);
            if (el.tagName === "DETAILS" && el.hasAttribute("data-level")) {
                return Number(el.getAttribute("data-level"));
            }
            return null;
        }

        // Process in REVERSE document order so that by the time we reach an
        // earlier/shallower heading, every later/deeper or same-level sibling
        // after it has already been wrapped — and is now recognizable via
        // siblingLevel() as a correct stopping boundary.
        for (let i = headings.length - 1; i >= 0; i--) {
            const heading = headings[i];
            const level = headingLevel(heading);
            const parent = heading.parentElement;
            if (!parent) continue;

            const content: Element[] = [];
            let sibling = heading.nextElementSibling;
            while (sibling) {
                const sLevel = siblingLevel(sibling);
                if (sLevel !== null && sLevel <= level) break;
                content.push(sibling);
                sibling = sibling.nextElementSibling;
            }

            const details = document.createElement("details");
            details.className = "md-fold";
            details.setAttribute("data-level", String(level));
            details.open = true; // expanded by default — folding is opt-in, not a barrier to reading

            const summary = document.createElement("summary");
            summary.className = "md-fold__summary";
            summary.appendChild(heading.cloneNode(true));

            details.appendChild(summary);
            for (const node of content) details.appendChild(node);

            parent.replaceChild(details, heading);
        }

        root.dataset.foldInit = "1";
    }

    foldHeadings();
    document.addEventListener("astro:page-load", foldHeadings);
    document.addEventListener("astro:before-swap", () => {
        // Reset the guard so a genuine navigation back to this page
        // (fresh markdown content) gets folded again from scratch.
        const root = document.getElementById("md-content");
        if (root) delete root.dataset.foldInit;
    });
</script>

<style>
    .md-page {
        min-height: 100dvh;
        overflow-y: auto;
        display: flex;
        justify-content: center;
        padding: var(--space-16) var(--space-6) var(--space-16);
    }

    .md-content {
        width: 100%;
        max-width: 720px;
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: var(--text-base);
        line-height: 1.7;
    }

    /* ── Headings ── */
    .md-content :global(h1) {
        font-family: var(--font-heading);
        font-size: var(--text-2xl);
        letter-spacing: 0.03em;
        margin-bottom: var(--space-2);
    }

    .md-content :global(h2) {
        font-family: var(--font-heading);
        font-size: var(--text-xl);
        letter-spacing: 0.02em;
        margin-top: var(--space-8);
        margin-bottom: var(--space-3);
        padding-bottom: var(--space-2);
        border-bottom: 1px solid var(--color-border);
    }

    .md-content :global(h3) {
        font-family: var(--font-heading);
        font-size: var(--text-lg);
        margin-top: var(--space-6);
        margin-bottom: var(--space-2);
    }

    .md-content :global(h4),
    .md-content :global(h5),
    .md-content :global(h6) {
        font-family: var(--font-body);
        font-weight: 700;
        margin-top: var(--space-4);
        margin-bottom: var(--space-2);
    }

    /* ── Foldable headings (h2-h6), added by the client-side fold script ── */
    .md-content :global(.md-fold) {
        margin-bottom: var(--space-2);
    }

    /* Nested folds (e.g. an h3 fold sitting inside an h2 fold) get a subtle
     left indent so the hierarchy stays visually legible once collapsed. */
    .md-content :global(.md-fold .md-fold) {
        margin-left: var(--space-4);
        padding-left: var(--space-4);
        border-left: 1px solid var(--color-border);
    }

    /* Strip default <summary> styling entirely — the heading element
     inside it already carries its own font/size/margin rules, cloned
     intact, so summary itself should be visually invisible. */
    .md-content :global(.md-fold__summary) {
        cursor: pointer;
        list-style: none;
        display: flex;
        align-items: baseline;
        gap: var(--space-2);
    }

    .md-content :global(.md-fold__summary::-webkit-details-marker) {
        display: none;
    }

    /* Custom chevron, replacing the native disclosure triangle — rotates
     on open instead of the browser's default marker swap. */
    .md-content :global(.md-fold__summary)::before {
        content: "\203a";
        display: inline-block;
        color: var(--color-accent);
        font-family: var(--font-body);
        transform: rotate(0deg);
        transition: transform var(--dur-base) var(--ease-out);
        flex-shrink: 0;
    }

    .md-content :global(.md-fold[open] > .md-fold__summary)::before {
        transform: rotate(90deg);
    }

    /* Headings lose their own margin-top when inside a summary — the
     fold wrapper (.md-fold) carries spacing instead, so two margins
     don't stack and create uneven gaps between folds. */
    .md-content :global(.md-fold__summary h2),
    .md-content :global(.md-fold__summary h3),
    .md-content :global(.md-fold__summary h4),
    .md-content :global(.md-fold__summary h5),
    .md-content :global(.md-fold__summary h6) {
        margin-top: 0;
        margin-bottom: 0;
        border-bottom: none; /* h2's own border moves to .md-fold below instead */
    }

    .md-content :global(.md-fold:has(> .md-fold__summary h2)) {
        margin-top: var(--space-8);
        padding-bottom: var(--space-2);
        border-bottom: 1px solid var(--color-border);
    }

    /* ── Body text ── */
    .md-content :global(p) {
        margin-bottom: var(--space-4);
        color: var(--color-text-dim);
    }

    .md-content :global(em) {
        color: var(--color-text-dim);
    }

    .md-content :global(a) {
        color: var(--color-primary);
        text-decoration: underline;
        text-decoration-color: var(--color-border-hover);
        text-underline-offset: 2px;
    }

    .md-content :global(a:hover) {
        text-decoration-color: var(--color-primary);
    }

    .md-content :global(strong) {
        color: var(--color-text);
    }

    .md-content :global(code) {
        background: var(--color-panel);
        border: 1px solid var(--color-border);
        border-radius: 4px;
        padding: 0.1em 0.4em;
        font-size: 0.9em;
    }

    /* ── Tables ── */
    .md-content :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: var(--space-6);
        font-size: var(--text-sm);
    }

    .md-content :global(th),
    .md-content :global(td) {
        text-align: left;
        padding: var(--space-2) var(--space-3);
        border-bottom: 1px solid var(--color-border);
    }

    .md-content :global(th) {
        color: var(--color-accent);
        font-family: var(--font-heading);
        font-weight: 400;
        letter-spacing: 0.04em;
        font-size: var(--text-xs);
        text-transform: lowercase;
    }

    .md-content :global(td) {
        color: var(--color-text-dim);
    }

    .md-content :global(tr:hover td) {
        color: var(--color-text);
    }

    /* ── Lists ── */
    .md-content :global(ul),
    .md-content :global(ol) {
        margin-bottom: var(--space-4);
        padding-left: var(--space-6);
        color: var(--color-text-dim);
    }

    .md-content :global(li) {
        margin-bottom: var(--space-1);
    }

    /* ── Misc ── */
    .md-content :global(hr) {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: var(--space-8) 0;
    }

    @media (max-width: 480px) {
        .md-page {
            padding: var(--space-12) var(--space-4) var(--space-12);
        }
    }
</style>
