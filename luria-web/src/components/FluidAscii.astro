---
interface Props {
  width?: number;
  height?: number;
  fontSize?: number;
}

const { width = 960, height = 540, fontSize = 10 } = Astro.props;
---

<div
  class="fluid-ascii"
  data-width={width}
  data-height={height}
  data-font-size={fontSize}
>
  <div data-role="fluid-container"></div>
  <canvas data-role="ascii-output"></canvas>
</div>

<style>
  .fluid-ascii {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }

  .fluid-ascii [data-role="fluid-container"] {
    width: 100%;
    height: 100%;
    touch-action: none;
  }
  .fluid-ascii [data-role="fluid-container"] canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The only thing actually visible. Sits on top in paint order because
     it's the positioned element; pointer-events:none lets all input fall
     through to the real fluid canvas underneath so interaction still works. */
  .fluid-ascii canvas[data-role="ascii-output"] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  import WebGLFluidEnhanced from "webgl-fluid-enhanced";
  import { textmode } from "textmode.js";

  function required<T extends Element>(el: T | null, selector: string): T {
    if (!el) {
      throw new Error(`FluidAscii: missing element for selector "${selector}"`);
    }
    return el;
  }

  function pixelSize(el: Element): { w: number; h: number } {
    const rect = el.getBoundingClientRect();
    return {
      w: Math.max(1, Math.round(rect.width)),
      h: Math.max(1, Math.round(rect.height)),
    };
  }

  function init(root: HTMLElement): void {
    const fluidContainer = required(
      root.querySelector<HTMLDivElement>('[data-role="fluid-container"]'),
      '[data-role="fluid-container"]',
    );
    const outputCanvas = required(
      root.querySelector<HTMLCanvasElement>('[data-role="ascii-output"]'),
      '[data-role="ascii-output"]',
    );

    const fontSize = Number(root.dataset.fontSize) || 10;
    const { w, h } = pixelSize(root);

    const fluid = new WebGLFluidEnhanced(fluidContainer);

    fluid.setConfig({
      densityDissipation: 1.5,
      velocityDissipation: 0.4,
      pressure: 0.8,
      curl: 25,
      splatRadius: 0.3,
      splatForce: 6000,
      shading: true,
      colorful: true,
      transparent: false,
    });

    fluid.start();

    const fluidCanvas = required(
      fluidContainer.querySelector<HTMLCanvasElement>("canvas"),
      "canvas (created by WebGLFluidEnhanced)",
    );

    const t = textmode.create({
      canvas: outputCanvas,
      width: w,
      height: h,
      fontSize,
      frameRate: 60,
    });

    type TextmodeTextureLike = ReturnType<typeof t.createTexture>;
    let fluidTex: TextmodeTextureLike | undefined;

    t.setup(() => {
      fluidTex = t.createTexture(fluidCanvas);
      fluidTex
        .characters(" .:-=+*#%@")
        .charColorMode("sampled")
        .cellColorMode("fixed")
        .cellColor(0, 0, 0);
    });

    t.draw(() => {
      t.background(0);
      if (fluidTex) {
        t.image(fluidTex);
      }
    });

    const ro = new ResizeObserver((): void => {
      const size = pixelSize(root);
      t.resizeCanvas(size.w, size.h);
    });
    ro.observe(root);
  }

  document
    .querySelectorAll<HTMLElement>(".fluid-ascii")
    .forEach((root) => init(root));
</script>