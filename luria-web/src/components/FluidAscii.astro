---
// FluidAscii.astro
// npm install textmode.js webgl-fluid-enhanced

interface Props {
    width?: number;
    height?: number;
    fontSize?: number;
    fill?: boolean;
    burstOnClick?: boolean;
}

const { width = 480, height = 270, fontSize = 12, fill = false, burstOnClick = true } = Astro.props;
---

<div
    class="fluid-ascii"
    data-width={width}
    data-height={height}
    data-font-size={fontSize}
    data-burst-on-click={burstOnClick}
    style={fill ? 'width:100%;height:100%;' : `width:100%;aspect-ratio:${width}/${height};`}>
    <div data-role="fluid-container"></div>
    <canvas data-role="ascii-output"></canvas>
</div>

<style>
    .fluid-ascii {
        position: relative;
        overflow: hidden;
        background: #000;
    }

    .fluid-ascii [data-role='fluid-container'] {
        width: 100%;
        height: 100%;
        touch-action: none;
    }
    .fluid-ascii [data-role='fluid-container'] canvas {
        width: 100%;
        height: 100%;
        display: block;
    }

    .fluid-ascii canvas[data-role='ascii-output'] {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        pointer-events: none;
    }
</style>

<script>
    import WebGLFluidEnhanced from 'webgl-fluid-enhanced';
    import { textmode } from 'textmode.js';

    type Fluid = InstanceType<typeof WebGLFluidEnhanced>;

    function required<T extends Element>(el: T | null, selector: string): T {
        if (!el) {
            throw new Error(`FluidAscii: missing element for selector "${selector}"`);
        }
        return el;
    }

    function pixelSize(el: Element): { w: number; h: number } {
        const rect = el.getBoundingClientRect();
        return {
            w: Math.max(1, Math.round(rect.width)),
            h: Math.max(1, Math.round(rect.height)),
        };
    }

    function waitForCanvas(container: HTMLElement): Promise<HTMLCanvasElement> {
        return new Promise((resolve) => {
            const check = () => {
                const canvas = container.querySelector<HTMLCanvasElement>('canvas');
                if (canvas && canvas.width > 0 && canvas.height > 0) {
                    resolve(canvas);
                } else {
                    requestAnimationFrame(check);
                }
            };
            check();
        });
    }

    const teardowns = new WeakMap<HTMLElement, () => void>();

    async function init(root: HTMLElement): Promise<void> {
        teardowns.get(root)?.();
        teardowns.delete(root);

        let cancelled = false;
        teardowns.set(root, () => {
            cancelled = true;
        });

        const fluidContainer = required(root.querySelector<HTMLDivElement>('[data-role="fluid-container"]'), '[data-role="fluid-container"]');
        const outputCanvas = required(root.querySelector<HTMLCanvasElement>('[data-role="ascii-output"]'), '[data-role="ascii-output"]');
        const fontSize = Number(root.dataset.fontSize) || 10;
        const burstEnabled = root.dataset.burstOnClick === 'true';

        const fluid = new WebGLFluidEnhanced(fluidContainer);
        fluid.setConfig({
            simResolution: 128,
            dyeResolution: 128,
            densityDissipation: 2.5,
            velocityDissipation: 0.8,
            pressure: 1.0,
            curl: 40,
            colorPalette: ['#6a00ff', '#974dff', '#a366ff', '#a666ff', '#d5b8ff'],
            brightness: 0.8,
            splatRadius: 0.2,
            splatForce: 2000,
            shading: false,
            colorful: false,
            transparent: false,
            bloom: false,
            sunrays: false,
        });
        fluid.start();

        const onContextMenu = (e: MouseEvent): void => {
            e.preventDefault();
            fluid.multipleSplats(3);
        };
        const onClick = (e: MouseEvent): void => {
            fluid.splatAtLocation(e.clientX, e.clientY, 0, 0);
        };
        if (burstEnabled) {
            fluidContainer.addEventListener('contextmenu', onContextMenu);
            fluidContainer.addEventListener('click', onClick);
        }

        const fluidCanvas = await waitForCanvas(fluidContainer);

        if (cancelled) {
            fluidContainer.removeEventListener('contextmenu', onContextMenu);
            fluidContainer.removeEventListener('click', onClick);
            fluid.stop();
            return;
        }

        const { w, h } = pixelSize(root);

        const t = textmode.create({
            canvas: outputCanvas,
            width: w,
            height: h,
            fontSize,
            frameRate: 30,
        });

        type TextmodeTextureLike = ReturnType<typeof t.createTexture>;
        let fluidTex: TextmodeTextureLike | undefined;

        t.setup(() => {
            fluidTex = t.createTexture(fluidCanvas);
            fluidTex.characters(' .:-*#@').charColorMode('sampled').cellColorMode('fixed').cellColor(0, 0, 0);
        });

        t.draw(() => {
            t.background(0);
            if (fluidTex) {
                t.image(fluidTex);
            }
        });

        const ro = new ResizeObserver(() => {
            const size = pixelSize(root);
            t.resizeCanvas(size.w, size.h);
        });
        ro.observe(root);

        teardowns.set(root, () => {
            cancelled = true;
            fluidContainer.removeEventListener('contextmenu', onContextMenu);
            fluidContainer.removeEventListener('click', onClick);
            ro.disconnect();
            t.noLoop();
            fluid.stop();
        });
    }

    function initAll(): void {
        document.querySelectorAll<HTMLElement>('.fluid-ascii').forEach((root) => {
            void init(root);
        });
    }

    function teardownAll(): void {
        document.querySelectorAll<HTMLElement>('.fluid-ascii').forEach((root) => {
            teardowns.get(root)?.();
            teardowns.delete(root);
        });
    }

    initAll();
    document.addEventListener('astro:page-load', initAll);
    document.addEventListener('astro:before-swap', teardownAll);
</script>
